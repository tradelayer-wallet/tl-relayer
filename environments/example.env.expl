SERVER_PORT=9191
NETWORK=LTC
RPC_USER=user
RPC_PASS=pass
RPC_HOST=localhost
RPC_PORT=9332
TL_LISTENER_URL=http://127.0.0.1:3000

# --- Security hardening (issue #1) -----------------------------------------
# Optional auth for state-changing routes (POST /tx/sendTx, /address/sync-watchonly,
# /address/watchonly/*, /rpc/*): when set, requests must send a matching
# x-api-key header. Unset = unauthenticated (legacy behavior, warning logged).
RELAYER_API_KEY=

# Faucet (GET /address/faucet/:address) is disabled unless explicitly enabled.
FAUCET_ENABLED=false
# Optional admin key for the faucet; when set, x-admin-api-key (or x-api-key)
# must match.
ADMIN_API_KEY=

# Comma-separated CORS origin allowlist. Unset = reflect any origin WITHOUT
# credentials (never combined with credentials:true).
CORS_ORIGINS=

# Set to 1 only when running behind a trusted reverse proxy: allows the
# attestation routes to trust cf-connecting-ip / x-real-ip / x-forwarded-for.
TRUST_PROXY=0

# Env-only bootstrap seed URL for POST /address/watchonly/bootstrap (client-supplied
# sourceUrl is ignored). Must be https:// unless ALLOW_INSECURE_BOOTSTRAP=1, and must
# not be a private/loopback/link-local/metadata address.
WATCHONLY_BOOTSTRAP_URL=
ALLOW_INSECURE_BOOTSTRAP=0

# BlockCypher API token (optional, never commit real tokens).
BLOCKCYPHER_TOKEN=

VPN_CRIMINALIP=__KEY__
VPN_IPHUB=__KEY__
VPN_IPINFO=__KEY__
VPN_IPHUNTER=__KEY__
VPN_VPNAPI=__KEY__
