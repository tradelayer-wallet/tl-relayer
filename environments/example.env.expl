SERVER_PORT=9191
NETWORK=LTC
RPC_USER=user
RPC_PASS=pass
RPC_HOST=localhost
RPC_PORT=9332
TL_LISTENER_URL=http://127.0.0.1:3000

# --- Security hardening (issue #1) -----------------------------------------
# Optional auth for non-safe (state-changing) routes. When set, EVERY route
# except GET/HEAD/OPTIONS requires a matching x-api-key header, with only a
# small explicit public allowlist (POST /attestation/ip, /attestation/check,
# /tx/decode). GET /address/faucet also requires the key. Unset = unauthenticated
# (legacy behavior, warning logged). The WS relay (/ws) validates the same key
# once at handshake (x-api-key header or ?apiKey= query param) and can then
# reach the same surface.
RELAYER_API_KEY=

# Faucet (GET /address/faucet/:address) is disabled unless explicitly enabled,
# and the server refuses to start when FAUCET_ENABLED=true and ADMIN_API_KEY is
# unset (the faucet would be unauthenticated).
FAUCET_ENABLED=false
# Required when FAUCET_ENABLED=true: x-admin-api-key (or x-api-key) must match.
# Note: the WS relay strips credential headers, so the faucet is HTTP-only.
ADMIN_API_KEY=

# Comma-separated CORS origin allowlist. Unset = reflect any origin WITHOUT
# credentials (never combined with credentials:true).
CORS_ORIGINS=

# Reverse-proxy deployments MUST set TRUST_PROXY=1 (accepted values: 1/true):
# only then do the attestation routes trust cf-connecting-ip / x-real-ip /
# x-forwarded-for (and only then can ATTESTATION_ALLOW_IP_OVERRIDE=1 apply).
# Never enable it when the server is directly reachable from the internet.
TRUST_PROXY=0

# Env-only bootstrap seed URL for POST /address/watchonly/bootstrap (client-supplied
# sourceUrl is ignored). Must be https:// unless ALLOW_INSECURE_BOOTSTRAP=1, and must
# not be a private/loopback/link-local/metadata address. The same policy is enforced
# again at the fetch sink for WATCHONLY_REGISTRY_SEED_URL (startup/reconcile), and
# bootstrap fetches never follow redirects.
WATCHONLY_BOOTSTRAP_URL=
ALLOW_INSECURE_BOOTSTRAP=0

# BlockCypher API token (optional, never commit real tokens).
BLOCKCYPHER_TOKEN=

VPN_CRIMINALIP=__KEY__
VPN_IPHUB=__KEY__
VPN_IPINFO=__KEY__
VPN_IPHUNTER=__KEY__
VPN_VPNAPI=__KEY__
